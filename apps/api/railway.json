{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @branchscout/api db:generate && pnpm --filter @branchscout/api build",
    "watchPatterns": [
      "apps/api/**",
      "packages/**",
      "pnpm-lock.yaml",
      "package.json",
      "turbo.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter @branchscout/api db:migrate:deploy && pnpm --filter @branchscout/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
