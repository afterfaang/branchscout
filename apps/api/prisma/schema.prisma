// BranchScout — Prisma Schema
// Multi-tenant. RLS migrations live in prisma/migrations/manual/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REGION_MANAGER
  BRANCH_MANAGER
  ANALYST
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  regions     Region[]
  branches    Branch[]
  invitations Invitation[]
  companies   Company[]
  savedSearches SavedSearch[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         Role     @default(BRANCH_MANAGER)
  branchId     String?
  isActive     Boolean  @default(true)
  // MFA
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?        @relation(fields: [branchId], references: [id])
  recoveryCodes  RecoveryCode[]
  invitationsSent Invitation[]  @relation("InvitedBy")
  savedSearches  SavedSearch[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Region {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches Branch[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Branch {
  id               String    @id @default(cuid())
  tenantId         String
  regionId         String?
  code             String
  name             String
  address          String
  // PostGIS geography(Point,4326) added via raw migration in Sprint 2
  catchmentPolygon Json?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  region      Region?      @relation(fields: [regionId], references: [id])
  users       User[]
  invitations Invitation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([deletedAt])
}

// MFA recovery codes — 10 per user, single-use, argon2id-hashed.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// User invitations — admin invites a new user; token is single-use, 24h validity.
// `tokenHash` is argon2id-hashed; raw token is delivered via email link.
model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  name        String
  role        Role      @default(BRANCH_MANAGER)
  branchId    String?
  invitedById String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch? @relation(fields: [branchId], references: [id])
  invitedBy User    @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([tenantId])
  @@index([email])
  @@index([expiresAt])
}

// Discovered company (cache + enriched data layer).
// Google Places ToS: place_id may be persisted indefinitely; other fields are
// cached for ~30 days (Sprint 4 enrichment) and refreshed on demand.
//
// Geographic queries: Sprint 2 uses (lat, lng) Float columns + a simple
// composite index. PostGIS GEOGRAPHY column is added later via manual migration
// (apps/api/prisma/migrations/manual/04_postgis_company.sql) when the
// extension is available; ST_DWithin queries replace lat/lng range scans then.
model Company {
  id                String   @id @default(cuid())
  tenantId          String
  googlePlaceId     String   @unique
  name              String
  formattedAddress  String?
  lat               Float?
  lng               Float?
  category          String?  // primary type from Places API
  types             String[] @default([])
  rating            Float?
  reviewCount       Int?
  photosJson        Json?
  hoursJson         Json?
  // Sprint 4+ enrichment fields (placeholders, populated later)
  websiteUri        String?
  phone             String?
  websiteSummaryText String?
  // Sprint 6 — MERSIS
  mersisNo          String?
  vergiNo           String?
  // Sprint 13 — lead score
  leadScore         Int?
  lastEnrichedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, lat, lng])
}

// Outbound API cost tracking — every paid external call writes one row.
// Used by `/admin/costs/today` dashboard and budget alerts (Sprint 8).
model ApiCostEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  provider  String   // e.g. "google_places", "anthropic"
  endpoint  String   // e.g. "nearby_search", "place_details", "messages.create"
  costUsd   Decimal  @db.Decimal(12, 6)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([provider, createdAt])
}

// User-saved map searches — a poligon, radius, or autocomplete-derived
// query the manager wants to revisit. queryJson keeps the full state so
// loading the search restores the map exactly. Tenant-scoped via RLS.
model SavedSearch {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  name      String
  queryJson Json     // { center?: {lat,lng}, radius?, polygon?: GeoJSON.Polygon, categories?: string[], zoom? }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}
