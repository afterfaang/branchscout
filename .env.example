# ===============================
# BranchScout — Environment Variables
# ===============================
# Copy this to .env and fill in values for local dev.
# Production values live in Railway dashboard.

# --- API ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Database (Postgres + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/branchscout?schema=public

# Redis (sessions, cache, BullMQ broker)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173

# --- Web ---
VITE_API_URL=http://localhost:4000
VITE_GOOGLE_MAPS_API_KEY=

# --- Providers (filled in later sprints) ---
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=
